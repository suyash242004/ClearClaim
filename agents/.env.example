# ClearClaim AI Agents — environment template
# Copy to .env and fill in. NEVER commit the real .env.

# Gemini (comma-separate multiple keys for automatic rotation)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model overrides (defaults: gemini-3.5-flash / gemini-2.5-flash)
# MODEL_NAME=gemini-3.5-flash
# FALLBACK_MODEL_NAME=gemini-2.5-flash

# PostgreSQL — local or Neon connection details
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medical_insurance
DB_USER=postgres
DB_PASSWORD=your_db_password

# .NET backend APIs
READ_API=http://localhost:5234
WRITE_API=http://localhost:5130

# X Layer blockchain (testnet chainId 1952)
XLAYER_RPC=https://testrpc.xlayer.tech
AGENT_PRIVATE_KEY=0x_your_agent_wallet_private_key
AGENT_WALLET_ADDRESS=0x_your_agent_wallet_address
CONTRACT_ADDRESS=0xed7c36ce8EB540e35604a9eeFa72f3b19106A709
RISK_ORACLE_ADDRESS=0x428bE934f782D0Ba4556cB84680bDe233d07cc1a
HEALTH_GUARDIAN_ADDRESS=0x0F4FEB6E515eEEb90bed9E6cC10f556a6c7287dE
HEALTH_PASSPORT_ADDRESS=0x63cC01DDC2aCd8a230679E29A7Be7EBe5769f3E3

# Observability (optional — LangSmith tracing)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_key
