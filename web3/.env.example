# web3/.env — Copy this to .env and fill in your values
# NEVER commit .env to git — it contains your private key!

# ── Your OKX Wallet ───────────────────────────────────────────────────────────
# Export from: OKX Wallet Extension → Settings → Security → Export Private Key
AGENT_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Your wallet public address (same wallet as above)
AGENT_ADDRESS=0xYOUR_WALLET_ADDRESS_HERE

# ── X Layer Network ───────────────────────────────────────────────────────────
XLAYER_RPC=https://testrpc.xlayer.tech

# Optional: for contract verification on explorer
XLAYER_EXPLORER_API_KEY=

# ── After Deployment (filled by deploy.js output) ─────────────────────────────
# Run: npx hardhat run scripts/deploy.js --network xlayer_testnet
# Then copy these 3 addresses from the output:
CONTRACT_ADDRESS=
RISK_ORACLE_ADDRESS=
HEALTH_GUARDIAN_ADDRESS=
HEALTH_PASSPORT_ADDRESS=
